{
  "name": "agent-hud-win",
  "version": "1.1.0",
  "description": "Agent HUD for Windows — 一条常驻悬浮条，实时显示本地 AI agent 的用量、额度与限流状态",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "node pack.js",
    "dist": "node dist.js",
    "test": "node --test \"test/*.test.js\"",
    "check:whale": "node --test test/whale-contract.test.js"
  },
  "keywords": [
    "electron",
    "hud",
    "overlay",
    "usage-monitor",
    "claude-code",
    "codex",
    "deepseek",
    "windows"
  ],
  "author": "wbzher",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbz2006/agent-hud-win.git"
  },
  "bugs": {
    "url": "https://github.com/wbz2006/agent-hud-win/issues"
  },
  "homepage": "https://github.com/wbz2006/agent-hud-win#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
