# 依赖
node_modules/

# 打包产物（体积大、可再生）
build/
dist/

# 运行时生成的用户配置与日志（含个人路径与中转站 Token，绝不入库）
config.json
error.log
*.log

# 调试截图与临时脚本
shot-*.png
_*.ps1
_*.cjs
anim/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 代码签名私钥与口令 —— 绝不入库
.certs/
*.pfx
*.p12
*-password.txt

# signtool 二进制（18MB，由 scripts/get-signtool.ps1 按需下载，不入库）
tools/signtool/

# build 被残留句柄锁住（EBUSY）时的备选输出目录
build2/
build3/
